{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Attach using Process Id",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "logToFile": true
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
              "PYTHONPATH": "${workspaceFolder}/server",
              "FLASK_APP": "run.py"
            },
            "args": [
              "run",
              "--no-debugger",
              "--no-reload"
            ],
            "jinja": true
          }
    ]
}